  "_comment": "Copy to local.config.json and fill in your own environment values. local.config.json is gitignored.",
  "_howToFind": {
    "tenantId / environmentId / orgUrl": "pac env who",
    "workflowId / workflowIdUnique": "pac env fetch --xml \"<fetch><entity name='workflow'><attribute name='workflowid'/><attribute name='workflowidunique'/><attribute name='name'/><attribute name='statecode'/><filter><condition attribute='name' operator='eq' value='YOUR-FLOW-NAME'/></filter></entity></fetch>\"",
    "publicClientId": "Azure CLI's well-known public client id. Used for the device code flow so that no app registration is required."
  },

